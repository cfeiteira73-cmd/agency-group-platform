# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
n8n-workflows/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# One-time outreach scripts (may contain API keys)
send_outreach*.mjs
send_outreach*.js

# Runtime logs and audit artefacts (not source)
/logs/
server.log
*.log

# Test artefacts
/playwright-report/
/test-results/

# One-time SQL execution scripts (scratch — not migrations)
RUN_*.sql

# Audit/report directories
/master-audit/
/revenue-activation/
/absolute-master-audit/

# Temp files
ts-check-new.txt
